# API (apps/api) — URL y clave service_role de tu proyecto Supabase
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=
PORT=3101
WEB_URL=http://localhost:5183

# Web (apps/web) — clave pública (anon / publishable)
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=

# Correo de la empresa para enviar facturas, recordatorios y peticiones de firma (sin esto, modo prueba).
# En local se puede usar el buzón de Supabase: SMTP_HOST=127.0.0.1, SMTP_PORT=56325, SMTP_FROM=facturas@stellagroup.test
# y los correos se ven en http://127.0.0.1:56324
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Secreto que manda Vercel Cron a /api/cron/recordatorios (cualquier texto largo y aleatorio)
CRON_SECRET=

# Usuario administrador de prueba SOLO para el Supabase local (se crea con:
#   pnpm crear-usuario $DEMO_EMAIL $DEMO_PASSWORD  tras pnpm db:reset)
DEMO_EMAIL=demo@stellagroup.test
DEMO_PASSWORD=OMiAR2vk91i4O5
