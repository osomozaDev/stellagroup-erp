{
  "name": "@stella/pdf",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react --external @react-pdf/renderer",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external react --external @react-pdf/renderer"
  },
  "dependencies": {
    "@stella/shared": "workspace:*",
    "@react-pdf/renderer": "^4.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
