{
  "name": "stellagroup-erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP sencillo para Stella Group: proyectos, presupuestos, facturas, cobros y servicios recurrentes",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "pnpm --filter @stella/shared build && pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "crear-usuario": "node scripts/crear-usuario.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
